# ── ERP EN LIGNE (master) — copier vers .env et remplir ──────────────────────
# Après avoir rempli ce fichier :  docker compose up -d --build

# ── Code source (cloné dans les images) ──
REPO_URL=https://github.com/zealot19/brainstore.git   # dépôt privé : https://<TOKEN>@github.com/owner/repo.git
REPO_REF=master

# ── Accès web ──
WEB_PORT=8080                 # l'appli sera sur http://<hôte>:8080

# ── Django ──
SECRET_KEY=REMPLACEZ_PAR_UNE_LONGUE_CLE_ALEATOIRE
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=0
ALLOWED_HOSTS=*                            # restreignez à votre domaine en prod (ex. erp.mondomaine.com)
CSRF_TRUSTED_ORIGINS=http://localhost:8080 # ajoutez votre URL réelle pour l'admin Django

# ── Base de données (service db) ──
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=REMPLACEZ_PAR_UN_MOT_DE_PASSE_FORT
DATABASE_URL=postgres://erp:REMPLACEZ_PAR_UN_MOT_DE_PASSE_FORT@db:5432/erp
LANGUAGE_CODE=fr-fr
TIME_ZONE=Africa/Abidjan

# ── Rôle de synchronisation : MASTER (les agences se synchronisent ici) ──
SYNC_ENABLED=1
NODE_ROLE=master
SYNC_TOKEN=REMPLACEZ_PAR_UN_JETON_PARTAGE_FORT   # à réutiliser à l'identique sur chaque agence

# ── Réservation en ligne (PWA /reserver) ──
ONLINE_COMPANY_ID=00000000-0000-0000-0000-000000000000   # UUID de l'institution servie
FAKE_PAYMENTS=1                 # 0 + Campay pour du vrai Mobile Money
