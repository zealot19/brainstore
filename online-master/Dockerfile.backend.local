# Backend Django — construit depuis le CODE LOCAL (pas de clone GitHub, pas de token).
# Contexte de build = racine du dépôt (voir docker-compose.local.yml).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DJANGO_SETTINGS_MODULE=config.settings.production

# Dépendances système WeasyPrint (rendu PDF des reçus/rapports).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libpango-1.0-0 libpangocairo-1.0-0 libpangoft2-1.0-0 \
    libgdk-pixbuf-2.0-0 libcairo2 libffi8 libharfbuzz0b libfontconfig1 \
    shared-mime-info fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src/backend
COPY backend/ /src/backend/

RUN pip install --upgrade pip && pip install -r requirements/production.txt

# Statiques (servis par WhiteNoise). SECRET_KEY factice suffit au build.
RUN SECRET_KEY=build-only python manage.py collectstatic --noinput

# Migrations au démarrage puis Gunicorn.
CMD sh -c 'python manage.py migrate --noinput && \
    gunicorn config.wsgi:application --bind 0.0.0.0:8000 --timeout ${WEB_TIMEOUT:-120}'
