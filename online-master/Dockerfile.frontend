# Frontend Angular — cloné depuis GitHub, construit (prod), servi par nginx qui
# proxifie aussi /api, /admin, /static, /media vers le backend (même origine).
# Rebuild dernier code :  docker compose build --no-cache frontend

# ── Étape build ───────────────────────────────────────────────────────────────
FROM node:20-alpine AS build

ARG REPO_URL=https://github.com/zealot19/brainstore.git
ARG REPO_REF=master
# apiUrl relatif → l'appli marche sur n'importe quel hôte/port (nginx proxifie /api).
ARG API_URL=/api/v1
ARG ONLINE_COMPANY_ID=00000000-0000-0000-0000-000000000000

RUN apk add --no-cache git
RUN git clone --depth 1 --branch ${REPO_REF} ${REPO_URL} /src
WORKDIR /src/angular

# Injecter la config de prod (apiUrl relatif + institution de la réservation en ligne).
RUN printf "export const environment = {\n  production: true,\n  apiUrl: '%s',\n  onlineCompanyId: '%s',\n};\n" \
    "${API_URL}" "${ONLINE_COMPANY_ID}" > src/environments/environment.prod.ts

RUN npm ci && npx ng build --configuration production

# ── Étape service ─────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine
COPY --from=build /src/angular/dist/angular/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
