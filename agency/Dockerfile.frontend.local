# Frontend Angular — construit depuis le CODE LOCAL (pas de clone GitHub).
# Contexte de build = racine du dépôt (voir docker-compose.local.yml).

# ── Étape build ───────────────────────────────────────────────────────────────
FROM node:20-alpine AS build

# apiUrl relatif → l'appli marche sur n'importe quel hôte/port (nginx proxifie /api).
ARG API_URL=/api/v1
ARG ONLINE_COMPANY_ID=00000000-0000-0000-0000-000000000000

WORKDIR /src/angular
COPY angular/ /src/angular/

# Injecter la config de prod (apiUrl relatif + institution de la réservation en ligne).
RUN printf "export const environment = {\n  production: true,\n  apiUrl: '%s',\n  onlineCompanyId: '%s',\n};\n" \
    "${API_URL}" "${ONLINE_COMPANY_ID}" > src/environments/environment.prod.ts

RUN npm ci && npx ng build --configuration production

# ── Étape service ─────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine
COPY --from=build /src/angular/dist/angular/browser /usr/share/nginx/html
COPY agency/nginx.conf /etc/nginx/conf.d/default.conf
