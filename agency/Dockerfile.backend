# Backend Django — cloné depuis GitHub puis construit (pas de code local requis).
# Rebuild pour récupérer le dernier code :  docker compose build --no-cache backend
FROM python:3.12-slim

ARG REPO_URL=https://github.com/zealot19/brainstore.git
ARG REPO_REF=master

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DJANGO_SETTINGS_MODULE=config.settings.production

# git + dépendances système WeasyPrint (rendu PDF des reçus/rapports).
RUN apt-get update && apt-get install -y --no-install-recommends \
    git libglib2.0-0 libpango-1.0-0 libpangocairo-1.0-0 libpangoft2-1.0-0 \
    libgdk-pixbuf-2.0-0 libcairo2 libffi8 libharfbuzz0b libfontconfig1 \
    shared-mime-info fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

# Cloner le dépôt (le backend Django est dans backend/).
# Dépôt privé ? Mettez un token dans REPO_URL :
#   https://<TOKEN>@github.com/<owner>/<repo>.git
RUN git clone --depth 1 --branch ${REPO_REF} ${REPO_URL} /src
WORKDIR /src/backend

RUN pip install --upgrade pip && pip install -r requirements/production.txt

# Statiques (servis par WhiteNoise). SECRET_KEY factice suffit au build.
RUN SECRET_KEY=build-only python manage.py collectstatic --noinput

# Migrations au démarrage puis Gunicorn.
CMD sh -c 'python manage.py migrate --noinput && \
    gunicorn config.wsgi:application --bind 0.0.0.0:8000 --timeout ${WEB_TIMEOUT:-120}'
