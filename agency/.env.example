# ── ERP AGENCE (locale) — copier vers .env et remplir ────────────────────────
# Une copie de ce dossier par agence. Après avoir rempli :  docker compose up -d --build

# ── Code source (cloné dans les images) ──
REPO_URL=https://github.com/zealot19/brainstore.git   # dépôt privé : https://<TOKEN>@github.com/owner/repo.git
REPO_REF=master

# ── Accès web ──
WEB_PORT=8080                 # l'appli sera sur http://<hôte>:8080

# ── Django ──
SECRET_KEY=REMPLACEZ_PAR_UNE_LONGUE_CLE_ALEATOIRE
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=0
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# ── Base de données locale de l'agence (service db) ──
POSTGRES_DB=erp_agency
POSTGRES_USER=erp_agency
POSTGRES_PASSWORD=REMPLACEZ_PAR_UN_MOT_DE_PASSE_FORT
DATABASE_URL=postgres://erp_agency:REMPLACEZ_PAR_UN_MOT_DE_PASSE_FORT@db:5432/erp_agency
LANGUAGE_CODE=fr-fr
TIME_ZONE=Africa/Abidjan

# ── Synchronisation : rôle AGENCE (se synchronise au master) ──
SYNC_ENABLED=1
NODE_ROLE=agency
NODE_ID=REMPLACEZ_PAR_UN_UUID_UNIQUE          # python3 -c "import uuid;print(uuid.uuid4())"
NODE_AGENCY_ID=UUID_DE_L_AGENCE_SUR_LE_MASTER # l'agence doit exister sur le master (avec un code)
SYNC_MASTER_URL=https://master.mondomaine.com/api/v1   # URL du master, suffixée /api/v1
SYNC_TOKEN=LE_MEME_JETON_QUE_LE_MASTER
SYNC_INTERVAL=90              # cadence sync_once (s)
RESERVE_INTERVAL=20          # cadence reserve_worker (s)

# ── Réservation en ligne (généralement inutile en agence) ──
ONLINE_COMPANY_ID=00000000-0000-0000-0000-000000000000
FAKE_PAYMENTS=1
