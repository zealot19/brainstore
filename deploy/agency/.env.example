# ── Per-agency instance config (copy to .env, fill in) ────────────────────────
# Django
SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=0
ALLOWED_HOSTS=agency-host.example.com,localhost,127.0.0.1

# Postgres (this agency's own DB)
POSTGRES_DB=erp_agency
POSTGRES_USER=erp_agency
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://erp_agency:change-me@db:5432/erp_agency

# Web
WEB_PORT=8000

# ── Sync (hub-and-spoke) ──────────────────────────────────────────────────────
SYNC_ENABLED=1
NODE_ROLE=agency
NODE_ID=            # a unique uuid for this instance
NODE_AGENCY_ID=     # the Agency UUID this instance serves (must exist on the master)
SYNC_MASTER_URL=https://master-host.example.com/api/v1
SYNC_TOKEN=         # same shared token as the master
SYNC_INTERVAL=90    # sync_once cadence (s)
RESERVE_INTERVAL=20 # reserve_worker cadence (s)

# Online payments: keep simulated until Campay is configured
FAKE_PAYMENTS=1

# Email/S3/etc. — copy from the master deployment as needed
