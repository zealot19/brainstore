# ── Config d'une instance AGENCE (copier en .env, puis renseigner) ────────────
# Sert les DEUX piles de ce dossier :
#   • docker-compose.web.yml  → agence complète avec UI (Caddy) — RECOMMANDÉ
#   • docker-compose.yml      → API seule (sans UI), accès direct sur WEB_PORT
#
# Django
SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=0
# Le(s) hôte(s) par lesquels l'app est jointe (domaine public OU nom LAN).
ALLOWED_HOSTS=agence1.mondomaine.com,localhost,127.0.0.1
# Origine(s) HTTPS de confiance (même hôte, schéma https). Requis derrière Caddy.
CSRF_TRUSTED_ORIGINS=https://agence1.mondomaine.com

# Postgres (base propre à cette agence)
POSTGRES_DB=erp_agency
POSTGRES_USER=erp_agency
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://erp_agency:change-me@db:5432/erp_agency

LANGUAGE_CODE=fr-fr
TIME_ZONE=Africa/Douala

# Port exposé UNIQUEMENT par la pile API-seule (docker-compose.yml).
# Ignoré par docker-compose.web.yml, où Caddy publie 80/443.
WEB_PORT=8000

# ── Sync (hub-and-spoke) ──────────────────────────────────────────────────────
SYNC_ENABLED=1
NODE_ROLE=agency
NODE_ID=            # uuid unique de cette instance :  python3 -c "import uuid;print(uuid.uuid4())"
NODE_AGENCY_ID=     # UUID de l'agence servie (doit exister sur le master, avec un code)
SYNC_MASTER_URL=https://erp.mondomaine.com/api/v1   # URL du master, suffixée /api/v1
SYNC_TOKEN=         # LE MÊME jeton partagé que le master
SYNC_INTERVAL=90    # cadence sync_once (s)
RESERVE_INTERVAL=20 # cadence reserve_worker (s)

# Paiement en ligne : simulé tant que Campay n'est pas configuré
FAKE_PAYMENTS=1

# Email/S3/etc. — recopier depuis le déploiement master au besoin
