# ── VPS "tout-en-un" — copier vers .env et compléter ─────────────────────────
# Django
SECRET_KEY=REMPLACEZ_PAR_UNE_LONGUE_CLE_ALEATOIRE
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=0
ALLOWED_HOSTS=erp.mondomaine.com
CSRF_TRUSTED_ORIGINS=https://erp.mondomaine.com
# CORS inutile : front et API sont sur le même domaine.

# ── IP SEULE, SANS DOMAINE (HTTP) ────────────────────────────────────────────
# Si vous servez l'app en HTTP sur l'IP du VPS (pas encore de domaine ni de TLS),
# remplacez les deux lignes ci-dessus par votre IP et DÉCOMMENTEZ les 3 lignes suivantes,
# sinon Django force une redirection https infinie et la connexion est cassée :
#   ALLOWED_HOSTS=203.0.113.10
#   CSRF_TRUSTED_ORIGINS=http://203.0.113.10
#   SECURE_SSL_REDIRECT=0
#   SESSION_COOKIE_SECURE=0
#   CSRF_COOKIE_SECURE=0
# Quand vous aurez un domaine : remettre le domaine + https, supprimer ces 3 lignes,
# et lancer certbot (voir le guide).

# Base de données (service "db")
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=REMPLACEZ_PAR_UN_MOT_DE_PASSE_FORT
DATABASE_URL=postgres://erp:REMPLACEZ_PAR_UN_MOT_DE_PASSE_FORT@db:5432/erp

# Langue / fuseau
LANGUAGE_CODE=fr-fr
TIME_ZONE=Africa/Douala

# Serveur central (si des agences se synchronisent ici — voir README-VPS.md, Annexe B)
SYNC_ENABLED=1
NODE_ROLE=master
SYNC_TOKEN=REMPLACEZ_PAR_UN_JETON_PARTAGE_FORT

# Paiement en ligne : simulé tant que Campay n'est pas configuré
FAKE_PAYMENTS=1

# (Optionnel) e-mail sortant, stockage S3, Sentry, WhatsApp… voir backend/.env.example
