msgid "Seule l'agence de destination peut réceptionner ou remettre ce colis."
msgstr "Only the destination agency can receive or hand over this parcel."
msgid "Seule l'agence d'origine peut expédier ce colis."
msgstr "Only the origin agency can dispatch this parcel."
msgid "Numéro invalide."
msgstr "Invalid number."
msgid "Le numéro doit être supérieur ou égal à 1."
msgstr "The number must be greater than or equal to 1."
msgid "Le point de départ et le point d'arrivée doivent différer."
msgstr "The departure and arrival points must differ."
msgid "Le colis ne peut être envoyé que vers un lieu rattaché à une agence."
msgstr "The parcel can only be sent to a location attached to an agency."
msgid "Le type choisi n'appartient pas à la nature sélectionnée."
msgstr "The chosen type does not belong to the selected nature."
msgid "Cette nature de colis est interdite au transport."
msgstr "This parcel nature is prohibited for transport."
msgid "Poids supérieur au maximum autorisé pour ce type de colis."
msgstr "Weight exceeds the maximum allowed for this parcel type."
msgid "Montant encaissé insuffisant : %(r)s < %(d)s."
msgstr "Insufficient amount received: %(r)s < %(d)s."
msgid "Un colis retiré ou annulé ne peut pas être modifié."
msgstr "A collected or cancelled parcel cannot be modified."
msgid "Nombre maximum de colis atteint pour ce voyage."
msgstr "Maximum number of parcels reached for this trip."
msgid "Capacité poids colis dépassée pour ce voyage."
msgstr "Parcel weight capacity exceeded for this trip."
msgid "Ce colis ne peut plus être affecté à un voyage."
msgstr "This parcel can no longer be assigned to a trip."
msgid "Ce voyage n'est pas ouvert au chargement."
msgstr "This trip is not open for loading."
msgid "Seul un colis non expédié peut être retiré du voyage."
msgstr "Only a non-dispatched parcel can be removed from the trip."
msgid "Seul un colis prêt peut être chargé."
msgstr "Only a ready parcel can be loaded."
msgid "Seul un colis prêt ou chargé peut être expédié."
msgstr "Only a ready or loaded parcel can be dispatched."
msgid "Seul un colis en transit peut être marqué arrivé."
msgstr "Only a parcel in transit can be marked as arrived."
msgid "Les quantités ne peuvent pas être négatives."
msgstr "Quantities cannot be negative."
msgid "Pièces reçues (%(r)s) supérieures aux pièces enregistrées (%(t)s)."
msgstr "Received pieces (%(r)s) exceed registered pieces (%(t)s)."
msgid "Reçues + manquantes dépassent le nombre de pièces enregistrées."
msgstr "Received + missing exceed the number of registered pieces."
msgid "Les pièces avariées ne peuvent pas dépasser les pièces reçues."
msgstr "Damaged pieces cannot exceed received pieces."
msgid "Aucune pièce disponible au retrait."
msgstr "No piece available for collection."
msgid "Nom du destinataire requis."
msgstr "Recipient name required."
msgid "La pièce (CNI) du destinataire est obligatoire."
msgstr "The recipient's ID (national ID) is required."
msgid "Nom et pièce (CNI) du mandataire sont obligatoires."
msgstr "The proxy's name and ID (national ID) are required."
msgid "Précisez si le retrait est fait par le destinataire ou un mandataire."
msgstr "Specify whether the collection is by the recipient or a proxy."
msgid "Seul un colis disponible peut être livré à domicile."
msgstr "Only an available parcel can be delivered to home."
msgid "Indiquez le montant de la livraison."
msgstr "Enter the delivery amount."
msgid "Un colis déjà expédié ne peut pas être annulé."
msgstr "A parcel that has already been dispatched cannot be cancelled."
msgid "Sélectionnez le voyage du bagage."
msgstr "Select the baggage trip."
msgid "Le passager (billet) est obligatoire."
msgstr "The passenger (ticket) is required."
msgid "Impossible d'ajouter un bagage à un billet annulé."
msgstr "Cannot add baggage to a cancelled ticket."
msgid "Le billet choisi n'appartient pas à ce voyage."
msgstr "The chosen ticket does not belong to this trip."
msgid "Poids supérieur au maximum autorisé pour ce type."
msgstr "Weight exceeds the maximum allowed for this type."
msgid "Un bagage retiré ou annulé ne peut pas être modifié."
msgstr "A collected or cancelled baggage cannot be modified."
msgid "Seul un bagage enregistré peut être chargé."
msgstr "Only a registered baggage can be loaded."
msgid "Seul un bagage enregistré ou chargé peut être retiré."
msgstr "Only a registered or loaded baggage can be collected."
msgid "Un bagage retiré ne peut pas être annulé."
msgstr "A collected baggage cannot be cancelled."
msgid "Ce colis ne peut plus être expédié."
msgstr "This parcel can no longer be dispatched."
msgid "Ce voyage ne dessert pas le trajet du colis (départ → destination)."
msgstr "This trip does not serve the parcel's route (departure → destination)."
msgid "La quantité expédiée doit être au moins 1."
msgstr "The dispatched quantity must be at least 1."
msgid "Quantité (%(q)s) supérieure au restant (%(r)s)."
msgstr "Quantity (%(q)s) exceeds the remaining (%(r)s)."
msgid "Seule une expédition en brouillon peut être validée."
msgstr "Only a draft shipment can be validated."
msgid "Le restant a changé : quantité supérieure au restant."
msgstr "The remaining has changed: quantity exceeds the remaining."
msgid "Seule une expédition validée peut être chargée."
msgstr "Only a validated shipment can be loaded."
msgid "Seule une expédition validée ou chargée peut être expédiée."
msgstr "Only a validated or loaded shipment can be dispatched."
msgid "Seule une expédition en transit peut être marquée arrivée."
msgstr "Only a shipment in transit can be marked as arrived."
msgid "Une expédition arrivée ne peut pas être annulée."
msgstr "An arrived shipment cannot be cancelled."
msgid "Cette expédition est partie ou clôturée : retrait impossible."
msgstr "This shipment has departed or is closed: removal is not possible."
msgid "Quantité à retirer invalide (1 à %(n)s)."
msgstr "Invalid quantity to remove (1 to %(n)s)."
msgid "Seul un administrateur peut dévalider une expédition."
msgstr "Only an administrator can invalidate a shipment."
msgid "Seule une expédition validée peut être dévalidée."
msgstr "Only a validated shipment can be invalidated."
msgid "Seule une expédition arrivée peut être réceptionnée."
msgstr "Only an arrived shipment can be received."
msgid "Pièces reçues supérieures aux pièces expédiées."
msgstr "Received pieces exceed dispatched pieces."
msgid "Reçues + manquantes dépassent les pièces expédiées."
msgstr "Received + missing exceed the dispatched pieces."

msgid "Le prix est inférieur au minimum autorisé (%(m)s)."
msgstr "The price is below the minimum allowed (%(m)s)."

msgid "Le prix est supérieur au maximum autorisé (%(m)s)."
msgstr "The price is above the maximum allowed (%(m)s)."
